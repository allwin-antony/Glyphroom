# ==============================================================================
# Enterprise Blogger 2.0 — Production Environment Configuration
# Copy to .env or .env.production before deployment:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. System & Deployment Settings
# ------------------------------------------------------------------------------
NODE_ENV=production
APP_ENV=production
APP_URL=http://localhost:4000
ALLOWED_ORIGINS=http://localhost,https://blog.corp.internal

# ------------------------------------------------------------------------------
# 2. PostgreSQL 16 Database Configuration
# ------------------------------------------------------------------------------
POSTGRES_DB=enterprise_blogger
POSTGRES_USER=blogger
# Automatically replaced with a secure random 32-byte secret by ./scripts/deploy.sh
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_PASSWORD_IN_PROD
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgres://blogger:REPLACE_WITH_STRONG_PASSWORD_IN_PROD@postgres:5432/enterprise_blogger

# ------------------------------------------------------------------------------
# 3. Collaboration Engine (Hocuspocus + standard ws)
# ------------------------------------------------------------------------------
COLLAB_PORT=4000
COLLAB_HOST=0.0.0.0
# Debounce flush constants (spec: docs/ROADMAP.md:83)
FLUSH_DEBOUNCE_MS=3000
FLUSH_MAX_DEBOUNCE_MS=10000

# ------------------------------------------------------------------------------
# 4. In-Process Agent Gateway
# ------------------------------------------------------------------------------
# Shared secret for authenticating internal requests between MCP server & Collab gateway
# Automatically replaced by ./scripts/deploy.sh if placeholder is present
GATEWAY_SECRET=REPLACE_WITH_STRONG_GATEWAY_SECRET
AGENT_GATEWAY_URL=http://collab:4000/internal/agent-gateway/edit

# ------------------------------------------------------------------------------
# 5. Model Context Protocol (MCP) Server
# ------------------------------------------------------------------------------
MCP_PORT=5000
MCP_HOST=0.0.0.0
MCP_TRANSPORT=sse

# ------------------------------------------------------------------------------
# 6. Optional: Redis Pub/Sub Adapter (Horizontal Clustering)
# Disabled by default; enable only when running multiple Collab container instances
# ------------------------------------------------------------------------------
REDIS_ENABLED=false
REDIS_URL=

# ------------------------------------------------------------------------------
# 7. Persistent Storage Paths (Local Bind-Mounts)
# ------------------------------------------------------------------------------
STORAGE_TYPE=local
ATTACHMENTS_DIR=./data/attachments
LOG_DIR=./data/logs

# ------------------------------------------------------------------------------
# 8. Logging & Audit
# ------------------------------------------------------------------------------
LOG_LEVEL=info
LOG_FORMAT=json

# ------------------------------------------------------------------------------
# 9. Cryptographic Secrets
# ------------------------------------------------------------------------------
JWT_SECRET=REPLACE_WITH_STRONG_JWT_SECRET
COOKIE_SECRET=REPLACE_WITH_STRONG_COOKIE_SECRET
