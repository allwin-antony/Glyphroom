# syntax=docker/dockerfile:1.4
# Enterprise Blogger 2.0 — REST API & Authentication Dockerfile
# Multi-stage build for pnpm monorepo (minimal Debian-slim, non-root user, dumb-init signal forwarding)

# ===========================================================================
# Stage 1: Base Runtime Environment
# ===========================================================================
FROM node:22-bookworm-slim AS base

RUN apt-get update && apt-get install -y --no-install-recommends \
    dumb-init \
    curl \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
RUN corepack enable && corepack prepare pnpm@12.15.0 --activate

WORKDIR /app

# ===========================================================================
# Stage 2: Monorepo Dependency Resolution
# ===========================================================================
FROM base AS dependencies

# Copy monorepo manifests for lockfile-deterministic layer caching
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml tsconfig.base.json ./
COPY packages/shared/package.json ./packages/shared/
COPY apps/collab/package.json ./apps/collab/
COPY apps/api/package.json ./apps/api/
COPY apps/mcp-server/package.json ./apps/mcp-server/
COPY tests/package.json ./tests/

# Install all dependencies (including devDependencies needed for build)
RUN pnpm install --frozen-lockfile

# ===========================================================================
# Stage 3: Compilation and Artifact Generation
# ===========================================================================
FROM dependencies AS builder

# Copy TypeScript source code
COPY packages/shared ./packages/shared
COPY apps/api ./apps/api

# Build shared package first
RUN pnpm --filter @enterprise-blogger/shared run build

# Build API server
RUN pnpm --filter @enterprise-blogger/api run build

# Prune devDependencies for minimal runtime image
RUN pnpm --filter @enterprise-blogger/api --prod deploy /app/pruned-api

# ===========================================================================
# Stage 4: Production Distroless-like Minimal Image
# ===========================================================================
FROM base AS runner

ENV NODE_ENV=production
ENV API_PORT=4000
ENV API_HOST=0.0.0.0

# Create dedicated non-privileged user and group for security
RUN groupadd -g 10001 blogger && \
    useradd -u 10001 -g blogger -s /bin/sh -m blogger

WORKDIR /app

# Copy deployed pruned workspace with compiled dist and prod node_modules
COPY --from=builder --chown=blogger:blogger /app/pruned-api /app

# Switch to non-root user
USER blogger

# Expose HTTP port
EXPOSE 4000

# Health check probe against /health
HEALTHCHECK --interval=10s --timeout=3s --start-period=5s --retries=3 \
    CMD curl -f http://127.0.0.1:4000/health || exit 1

# Launch with dumb-init for graceful SIGTERM/SIGINT process handling
ENTRYPOINT ["/usr/bin/dumb-init", "--"]
CMD ["node", "dist/index.js"]
