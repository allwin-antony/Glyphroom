# syntax=docker/dockerfile:1.4
# Enterprise Blogger 2.0 — Collaboration Engine Dockerfile
# Multi-stage build for pnpm monorepo (minimal Debian-slim, non-root user, dumb-init signal forwarding)

# ===========================================================================
# Stage 1: Base Runtime Environment
# ===========================================================================
FROM node:22-bookworm-slim AS base

RUN apt-get update && apt-get install -y --no-install-recommends \
    dumb-init \
    curl \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
RUN corepack enable && corepack prepare pnpm@12.15.0 --activate

WORKDIR /app

# ===========================================================================
# Stage 2: Monorepo Dependency Resolution
# ===========================================================================
FROM base AS dependencies

# Copy monorepo manifests for lockfile-deterministic layer caching
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml tsconfig.base.json ./
COPY packages/shared/package.json ./packages/shared/
COPY apps/collab/package.json ./apps/collab/
COPY apps/api/package.json ./apps/api/
COPY apps/mcp-server/package.json ./apps/mcp-server/
COPY apps/web/package.json ./apps/web/
COPY tests/package.json ./tests/

# Install all dependencies (including devDependencies needed for build)
RUN pnpm install --frozen-lockfile

# ===========================================================================
# Stage 3: Compilation and Artifact Generation
# ===========================================================================
FROM dependencies AS builder

# Copy TypeScript source code
COPY packages/shared ./packages/shared
COPY apps/collab ./apps/collab

# Build shared package first (required dependency of apps/collab)
RUN pnpm --filter @enterprise-blogger/shared run build

# Build collaboration server
RUN pnpm --filter @enterprise-blogger/collab run build

# Isolate production dependencies and bundle workspace references
RUN pnpm --filter @enterprise-blogger/collab --prod deploy /app/deployed

# ===========================================================================
# Stage 4: Production Runner (Minimal & Hardened)
# ===========================================================================
FROM base AS runner

ENV NODE_ENV=production
ENV PORT=4000
ENV HOST=0.0.0.0

WORKDIR /app

# Create unprivileged system user for container security
RUN groupadd -g 10001 blogger && \
    useradd -u 10001 -g blogger -s /bin/sh -d /app blogger && \
    mkdir -p /app/logs /app/attachments && \
    chown -R blogger:blogger /app

# Copy deployed standalone bundle from builder stage
COPY --from=builder --chown=blogger:blogger /app/deployed /app

# Also copy built dist from shared if referenced via module resolution
COPY --from=builder --chown=blogger:blogger /app/packages/shared/dist /app/node_modules/@enterprise-blogger/shared/dist

# Expose Collaboration WebSocket and HTTP Agent Gateway port
EXPOSE 4000

# Drop root privileges
USER blogger

# dumb-init forwards SIGTERM/SIGINT directly to Node to trigger debounced persistence flush
ENTRYPOINT ["/usr/bin/dumb-init", "--"]

# Launch compiled collaboration server
CMD ["node", "dist/index.js"]
