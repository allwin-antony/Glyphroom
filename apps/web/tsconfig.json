{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "rootDir": "./src",
    "outDir": "./dist",
    "tsBuildInfoFile": "./dist/tsconfig.tsbuildinfo",
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@glyphroom/shared": [
        "../../packages/shared/src/index.ts"
      ],
      "@glyphroom/shared/*": [
        "../../packages/shared/src/*"
      ]
    }
  },
  "references": [
    {
      "path": "../../packages/shared"
    }
  ],
  "include": [
    "src/**/*"
  ]
}