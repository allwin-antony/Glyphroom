{
  "name": "glyphroom",
  "version": "0.1.0",
  "private": true,
  "description": "Glyphroom — Self-hosted collaborative enterprise knowledge & documentation platform featuring real-time CRDT convergence, Yjs suggestion mode, and AI agent co-editing.",
  "author": "Allwin <santonyallwin@gmail.com>",
  "license": "Apache-2.0",
  "homepage": "https://github.com/allwin-antony/Glyphroom#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/allwin-antony/Glyphroom.git"
  },
  "bugs": {
    "url": "https://github.com/allwin-antony/Glyphroom/issues"
  },
  "keywords": [
    "glyphroom",
    "crdt",
    "yjs",
    "prosemirror",
    "tiptap",
    "hocuspocus",
    "mcp",
    "model-context-protocol",
    "real-time",
    "collaboration",
    "enterprise-wiki",
    "knowledge-base",
    "fastify",
    "react"
  ],
  "packageManager": "pnpm@12.15.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm --parallel --filter @enterprise-blogger/shared --filter @enterprise-blogger/api --filter @enterprise-blogger/collab --filter @enterprise-blogger/web run dev",
    "build": "pnpm -r run build",
    "test": "pnpm --filter @enterprise-blogger/shared test",
    "test:shared": "pnpm --filter @enterprise-blogger/shared test",
    "test:api": "pnpm --filter @enterprise-blogger/api test",
    "test:web": "pnpm --filter @enterprise-blogger/web test",
    "test:collab": "pnpm --filter @enterprise-blogger/collab test",
    "test:mcp": "pnpm --filter @enterprise-blogger/mcp-server test",
    "test:tests": "pnpm --filter @enterprise-blogger/tests test",
    "test:convergence": "pnpm --filter @enterprise-blogger/tests test:convergence",
    "test:fixtures": "pnpm --filter @enterprise-blogger/tests test:fixtures",
    "test:all": "pnpm -r run test",
    "typecheck": "pnpm -r run typecheck",
    "lint:licenses": "pnpm licenses list",
    "clean": "pnpm -r run clean"
  },
  "dependencies": {
    "@hocuspocus/extension-database": "4.7.1",
    "@hocuspocus/extension-redis": "4.7.1",
    "@hocuspocus/provider": "4.7.1",
    "@hocuspocus/server": "4.7.1",
    "@tiptap/core": "3.32.0",
    "@tiptap/pm": "3.32.0",
    "diff": "8.0.2",
    "dotenv": "16.4.7",
    "fastify": "5.2.1",
    "katex": "0.16.21",
    "mermaid": "11.4.1",
    "pg": "8.13.1",
    "pg-mem": "3.0.5",
    "pino": "9.6.0",
    "prosemirror-model": "1.24.1",
    "prosemirror-state": "1.4.3",
    "prosemirror-transform": "1.10.3",
    "prosemirror-view": "1.38.1",
    "ws": "8.18.0",
    "y-prosemirror": "1.3.7",
    "y-protocols": "1.0.6",
    "yjs": "13.6.33",
    "zod": "3.24.2"
  },
  "devDependencies": {
    "@types/jsdom": "21.1.7",
    "@types/katex": "0.16.7",
    "@types/node": "22.13.4",
    "@types/pg": "8.11.11",
    "@types/ws": "8.5.14",
    "jsdom": "26.0.0",
    "tsx": "4.19.2",
    "typescript": "5.7.3",
    "vitest": "3.0.5"
  },
  "overrides": {
    "yjs": "13.6.33",
    "y-protocols": "1.0.6",
    "prosemirror-model": "1.24.1",
    "prosemirror-state": "1.4.3",
    "prosemirror-view": "1.38.1",
    "prosemirror-transform": "1.10.3",
    "ws": "8.18.0"
  }
}
